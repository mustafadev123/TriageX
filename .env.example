# TriageX environment — copy to .env (repo root) and fill in. Never commit .env.
# All values are read server-side only; nothing here is exposed to the frontend.

LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# --- Tiger Data (Phase 4) ---
# Connection string from Tiger Console, e.g. postgres://user:pass@host:port/tsdb?sslmode=require
DATABASE_URL=

# --- AI providers (Phase 5) ---
# Model IDs are confirmed against official SDK docs in Phase 5; leave blank until then.
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_PROVIDER=gemini

# --- Chert (Phase 6) ---
# Leave blank to run with the clearly labeled mock adapter.
CHERT_SIGNING_SECRET=
CHERT_TENANT=
CHERT_WEBHOOK_SECRET=
# Comma-separated E.164 numbers of explicitly opted-in teammates only.
DEMO_ALLOWED_PHONES=
# Public HTTPS base URL of the tunnel that forwards to the backend (for the Chert webhook).
PUBLIC_BASE_URL=
